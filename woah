(function () {
    const _a = document.querySelector('#friendsDialogCloseButton');
    if (_a) _a.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true }));

    const _origOpen = XMLHttpRequest.prototype.open;
    XMLHttpRequest.prototype.open = function (m, u) {
        this.addEventListener("load", function () {
            try {
                let _j = JSON.parse(this.responseText);
                if (_j && _j.unfindable !== undefined) {
                    _j.unfindable = false;
                    Object.defineProperty(this, "responseText", { value: JSON.stringify(_j) });
                }
            } catch (e) { }
        });
        return _origOpen.apply(this, arguments);
    };

    const _white = document.createElement('div');
    Object.assign(_white.style, {
        position: "fixed",
        top: "0",
        left: "0",
        width: "100%",
        height: "100%",
        background: "#fff",
        zIndex: "2000",
        opacity: "1",
        transition: "opacity 1.5s"
    });
    document.body.appendChild(_white);

    setTimeout(() => {
        const _load = document.createElement('div');
        _load.id = "loadingAnimation";
        _load.innerHTML = `
            <div class="text">
                <span id="loadingMessage">Items loading 1/585...</span><br>
                <a id="skipLoading" href="#">Skip loading</a><br>
                (please contact kingtortle on discord if there are issues)
            </div>
        `;
        Object.assign(_load.style, {
            fontFamily: "'Press Start 2P', sans-serif",
            position: "absolute",
            left: "0",
            top: "100px",
            width: "100%",
            height: "300px",
            color: "#aaa",
            textAlign: "center",
            fontSize: "11px",
            lineHeight: "17px",
            backgroundColor: "transparent",
            zIndex: "2001",
            opacity: 0,
            transition: "opacity 0.3s"
        });
        document.body.appendChild(_load);

        _load.style.opacity = 1;

        setTimeout(() => {
            const _skip = document.getElementById("skipLoading");
            if (_skip) {
                _skip.style.color = "black";
                _skip.addEventListener("click", e => {
                    e.preventDefault();
                    _skip.innerText = "DENIED";
                    _skip.style.color = "red";
                });
            }
        }, 50);

        const _msg = document.getElementById("loadingMessage");
        let _count = 1;
        const _total = 585;

        const _int = setInterval(() => {
            if (_count < _total) {
                _count++;
                _msg.textContent = `Items loading ${_count}/${_total}...`;
            } else {
                clearInterval(_int);
            }
        }, 10);

        setTimeout(() => {
            _load.style.opacity = 0;

            setTimeout(() => {
                _white.style.opacity = 0;

                setTimeout(() => {
                    _white.remove();
                    _load.remove();
                }, 1500);

            }, 2000);

        }, 4000);

    }, 6000);
})();
